{
  "name": "six-seven",
  "version": "0.1.0",
  "description": "Six Seven \u2014 web app interattiva con avatar 3D (prototipo Fase 1)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:avatar": "tsx tools/build-avatar.ts && npm run compress:avatar",
    "compress:avatar": "gltf-transform meshopt public/assets/avatar.glb public/assets/avatar.glb",
    "typecheck": "tsc --build --force",
    "build": "npm run build:avatar && npm run typecheck && npm run check:naming && npm run check:game && vite build",
    "preview": "vite preview",
    "check:naming": "tsx tools/check-naming.ts",
    "check:game": "tsx tools/check-game.ts"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^22.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.169.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vite": "^8.3.5"
  }
}
