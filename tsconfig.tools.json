{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tools.tsbuildinfo"
  },
  "include": [
    "tools",
    "vite.config.ts",
    "src/assets/BoneNaming.ts",
    "src/assets/AssetCatalog.ts",
